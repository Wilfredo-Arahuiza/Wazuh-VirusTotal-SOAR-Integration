<!-- Wazuh Manager Integration Block (ossec.conf) -->
<integration>
  <name>virustotal</name>
  <api_key>YOUR_VIRUSTOTAL_API_KEY</api_key>
  <group>syscheck</group>
  <alert_format>json</alert_format>
</integration>

<!-- Windows Agent Real-Time FIM Configuration (ossec.conf) -->
<syscheck>
  <directories check_all="yes" realtime="yes">C:\MalwareTest</directories>
</syscheck>
